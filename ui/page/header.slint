import { Icons, Theme } from "../theme.slint";
import { Api, CardItem, RowItem } from "../types.slint";
import { Art } from "../widgets/art.slint";
import { ActionPill, IconButton, PillButton, PlayButton } from "../widgets/buttons.slint";
import { MenuDivider, MenuEntry, PopupMenu } from "../widgets/menu.slint";
import { Layout } from "layout.slint";

export component TopResult inherits Rectangle {
    in property <CardItem> card;
    property <bool> hot: touch.has-hover || top-play.has-hover;
    height: Layout.top-height - 36px;
    border-radius: 8px;
    background: root.hot ? Theme.highlight : Theme.elevated;
    animate background { duration: Theme.normal; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Api.navigate(root.card.kind, root.card.id); }
    }

    Art {
        x: 20px;
        y: 20px;
        width: 96px;
        height: 96px;
        source: root.card.art;
        round: root.card.round;
        radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
    }

    Text {
        x: 20px;
        y: 132px;
        width: parent.width - 120px;
        text: root.card.title;
        overflow: elide;
        font-size: 30px;
        font-weight: 700;
        font-family: Theme.display-font;
        color: Theme.text;
    }

    Text {
        x: 20px;
        y: 172px;
        width: parent.width - 120px;
        text: root.card.subtitle;
        overflow: elide;
        font-size: 14px;
        color: Theme.text-secondary;
    }

    Rectangle {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - (root.hot ? 20px : 12px);
        width: 52px;
        height: 52px;
        opacity: root.hot ? 1 : 0;
        animate y, opacity {
            duration: Theme.normal;
            easing: ease-out;
        }
        top-play := PlayButton {
            size: 52px;
            clicked => { Api.play-card(root.card.kind, root.card.id); }
        }
    }
}

component HeaderIcon inherits IconButton {
    size: 40px;
    icon-size: 24px;
}

/// A page header's buttons, beside its artwork or in a row beneath it.
component HeaderActions inherits HorizontalLayout {
    in property <RowItem> data;
    /// The "more" button was clicked; where to open its menu, in window coordinates.
    callback more(at: Point);
    spacing: 12px;
    alignment: start;
    cross-axis-alignment: center;
    if root.data.can-play: ActionPill {
        primary: true;
        icon: Icons.play;
        text: "Play";
        clicked => { Api.header-action("play"); }
    }
    if root.data.can-shuffle: ActionPill {
        icon: Icons.shuffle;
        text: "Shuffle";
        clicked => { Api.header-action("shuffle"); }
    }
    if root.data.can-radio: HeaderIcon {
        icon: Icons.radio;
        clicked => { Api.header-action("radio"); }
    }
    if root.data.can-download: HeaderIcon {
        icon: root.data.downloaded ? Icons.downloaded : Icons.download;
        active: root.data.downloaded;
        clicked => { Api.header-action("download"); }
    }
    if root.data.can-save: HeaderIcon {
        icon: root.data.saved ? Icons.in-library : Icons.save-to-playlist;
        active: root.data.saved;
        accessible-role: button;
        accessible-label: root.data.saved ? "Remove from library" : "Save to library";
        accessible-action-default => { Api.header-action("save"); }
        clicked => { Api.header-action("save"); }
    }
    if root.data.can-subscribe: PillButton {
        text: root.data.subscribed ? "Subscribed" : "Subscribe";
        primary: !root.data.subscribed;
        clicked => { Api.header-action("subscribe"); }
    }
    if root.data.can-share: HeaderIcon {
        icon: Icons.more;
        clicked => { root.more({ x: self.absolute-position.x, y: self.absolute-position.y + self.height }); }
    }
}

export component PageHeader {
    in property <RowItem> data;
    in property <length> full-width;
    property <length> art-height: Layout.header-art-height(root.data);
    property <bool> inline: Layout.header-inline(root.data, root.width);
    // The text sits level with the artwork's foot.
    property <length> bottom: Layout.has-art(root.data) ? Layout.header-art-inset : 24px;
    property <length> title-size: root.data.title.character-count <= 12 ? 76px : root.data.title.character-count <= 18 ? 60px : root.data.title.character-count <= 28 ? 44px : 34px;
    // A banner is darkened behind its text, which stays white in every look.
    property <color> fg: root.data.banner ? Theme.on-colour : Theme.text;
    property <color> fg-secondary: root.data.banner ? Theme.on-colour.with-alpha(0.7) : Theme.text-secondary;

    /// Where the menu was asked for, in window coordinates.
    property <Point> menu-at;

    function open-menu(at: Point) {
        root.menu-at = at;
        menu.show();
    }

    menu := PopupMenu {
        x: root.menu-at.x - root.absolute-position.x;
        y: root.menu-at.y - root.absolute-position.y;
        MenuEntry {
            text: "Copy link";
            icon: Icons.link;
            activated => { Api.header-action("copy-link"); }
        }

        if Api.own-playlist: MenuEntry {
            text: "Rename";
            icon: Icons.edit;
            activated => { Api.header-action("rename"); }
        }
        if Api.own-playlist: MenuDivider { }
        if Api.own-playlist: MenuEntry {
            text: "Public";
            icon: Api.own-privacy == 0 ? Icons.check : "";
            active: Api.own-privacy == 0;
            activated => { Api.header-action("public"); }
        }
        if Api.own-playlist: MenuEntry {
            text: "Unlisted";
            icon: Api.own-privacy == 1 ? Icons.check : "";
            active: Api.own-privacy == 1;
            activated => { Api.header-action("unlisted"); }
        }
        if Api.own-playlist: MenuEntry {
            text: "Private";
            icon: Api.own-privacy == 2 ? Icons.check : "";
            active: Api.own-privacy == 2;
            activated => { Api.header-action("private"); }
        }
        if Api.own-playlist: MenuDivider { }
        if Api.own-playlist: MenuEntry {
            text: "Delete playlist";
            icon: Icons.delete;
            activated => { Api.header-action("delete"); }
        }
    }

    if root.data.banner: Rectangle {
        x: -Theme.page-padding;
        y: 0;
        width: root.full-width;
        height: root.art-height;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.data.art;
            image-fit: cover;
            opacity: root.data.art.width > 0 ? 1 : 0;
            animate opacity { duration: 400ms; }
        }

        Rectangle {
            background: @linear-gradient(180deg, #00000000 35%, #000000b0 100%);
        }
    }

    // The artwork blurred across the header, under its own copy.
    if !root.data.banner: Rectangle {
        x: -Theme.page-padding;
        width: root.full-width;
        height: root.height;
        clip: true;
        opacity: root.data.backdrop.width > 0 ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 400ms; }
        Image {
            width: 100%;
            height: 100%;
            source: root.data.backdrop;
            image-fit: cover;
        }

        // Washed towards the page so text reads in every look, then fading into it.
        Rectangle {
            background: @linear-gradient(180deg, Theme.panel.with-alpha(Theme.light ? 0.7 : 0.55) 45%, Theme.panel 100%);
        }
    }

    HorizontalLayout {
        y: 0;
        height: root.art-height;
        padding-bottom: root.bottom;
        spacing: Layout.header-art-gap;
        alignment: start;
        if Layout.has-art(root.data): Art {
            y: parent.height - self.height - root.bottom;
            width: Layout.header-art;
            height: Layout.header-art;
            source: root.data.art;
            round: root.data.round;
            radius: 8px;
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #00000099;
        }
        VerticalLayout {
            alignment: end;
            spacing: 4px;
            Text {
                text: root.data.label.to-uppercase();
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.2px;
                color: root.fg-secondary;
            }

            Text {
                text: root.data.title;
                font-size: root.title-size;
                font-weight: 800;
                font-family: Theme.display-font;
                letter-spacing: root.title-size * -0.02;
                color: root.fg;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 0;
                alignment: start;
                if root.data.subtitle != "": Text {
                    text: root.data.subtitle;
                    font-size: 14px;
                    font-weight: 700;
                    color: root.fg;
                    overflow: elide;
                }
                if root.data.subtitle != "" && root.data.meta != "": Text {
                    text: " • ";
                    font-size: 14px;
                    color: root.fg-secondary;
                }
                if root.data.meta != "": Text {
                    text: root.data.meta;
                    font-size: 14px;
                    color: root.fg-secondary;
                    overflow: elide;
                }
            }

            if root.inline: HeaderActions {
                padding-top: 16px;
                data: root.data;
                more(at) => { root.open-menu(at); }
            }
        }
    }

    if Layout.header-actions(root.data, root.width): HeaderActions {
        y: root.art-height;
        height: Layout.actions-height;
        data: root.data;
        more(at) => { root.open-menu(at); }
    }
}
