import { Icons, Theme } from "../theme.slint";
import { Api, QueueItem } from "../types.slint";
import { Art } from "../widgets/art.slint";
import { Icon, IconButton } from "../widgets/buttons.slint";
import { MenuEntry, PopupMenu, SongAccountEntries } from "../widgets/menu.slint";
import { Equalizer } from "../widgets/spinner.slint";

/// The dragged queue row and its song, the pointer's window y and where the row
/// was grabbed; not kept in the row, which the list drops once scrolled away.
export global Drag {
    in-out property <int> from: -1;
    in-out property <string> song;
    in-out property <length> pointer;
    in-out property <length> grab;
}

export component PanelAction inherits Text {
    callback clicked();
    vertical-alignment: center;
    font-size: 13px;
    font-weight: 600;
    color: touch.has-hover ? Theme.text : Theme.text-secondary;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    in property <int> index;
    /// How many rows are selected; actions on a selected row apply to all.
    in property <int> selected-count;
    /// The copy carried under the pointer.
    in property <bool> ghost;
    /// The panel is open, which a closed one keeps its rows through.
    in property <bool> shown;
    callback clicked(control: bool, shift: bool);
    callback remove();
    callback remove-selected();
    callback play-next();
    callback play-next-selected();
    callback dropped();
    callback wheel(delta: length);
    property <bool> many: root.item.selected && root.selected-count > 1;
    /// One song's YouTube actions, which a local file has none of.
    property <bool> youtube: Api.signed-in && !root.many && !root.item.local;
    /// This row started the drag and still has the pointer.
    property <bool> dragging;
    // Ended elsewhere, as by the queue changing under it.
    property <bool> drag-live: Drag.from >= 0;
    changed drag-live => {
        if !self.drag-live {
            root.dragging = false;
        }
    }
    // Its place stays empty while carried.
    property <bool> dragged: !root.ghost && Drag.from == root.index;
    property <length> pressed-y;
    /// Pressed here: closing a menu takes the press, and its release alone isn't a click.
    property <bool> held;
    // The remove button counts as hovering the row, or they would flicker;
    // nothing is hot while a row is dragged over the others.
    property <bool> hot: (touch.has-hover || remove-button.has-hover) && Drag.from < 0;
    // As `PageRow`'s.
    property <string> art-key: root.shown && root.item.art.width == 0 ? "\{root.index}/\{root.item.id}" : "";
    height: Theme.queue-row;

    function ask-art() {
        if root.art-key != "" {
            Api.queue-art(root.index);
        }
    }
    init => { root.ask-art(); }
    changed art-key => { root.ask-art(); }

    /// Where the menu was asked for, in window coordinates.
    property <Point> menu-at;
    // The song as the menu opened, as an edit may hand this row another.
    property <string> menu-song;
    property <string> block-label;

    menu := PopupMenu {
        x: root.menu-at.x - root.absolute-position.x;
        y: root.menu-at.y - root.absolute-position.y;
        MenuEntry {
            text: root.many ? "Play " + root.selected-count + " next" : "Play next";
            icon: Icons.play-next;
            enabled: root.many || !root.item.current;
            activated => {
                if root.many {
                    root.play-next-selected();
                } else {
                    root.play-next();
                }
            }
        }

        MenuEntry {
            text: root.many ? "Remove " + root.selected-count + " from queue" : "Remove from queue";
            icon: Icons.close;
            enabled: root.many || !root.item.current;
            activated => {
                if root.many {
                    root.remove-selected();
                } else {
                    root.remove();
                }
            }
        }

        if !root.many && !root.item.local: MenuEntry {
            text: root.item.downloaded ? "Remove download" : "Download";
            icon: root.item.downloaded ? Icons.delete : Icons.download;
            activated => { Api.download(root.item.id, root.item.downloaded); }
        }

        if !root.many && !root.item.local: MenuEntry {
            text: "Copy link";
            icon: Icons.link;
            activated => { Api.card-action("copy-link", "song", root.item.id); }
        }

        if !root.many && root.block-label != "": MenuEntry {
            text: root.block-label;
            icon: Icons.block;
            activated => { Api.card-action("block", "song", root.menu-song); }
        }

        if root.youtube: SongAccountEntries {
            song: root.item.id;
            can-clear-rating: !root.item.current;
        }
    }

    touch := TouchArea {
        enabled: !root.ghost;
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(ev) => {
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up && !root.dragging {
                root.menu-at = { x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y };
                root.menu-song = root.item.id;
                root.block-label = Api.block-label("song", root.menu-song);
                menu.show();
            }
            // Sent with no button, as the grab is lost.
            if ev.kind == PointerEventKind.cancel {
                root.dragging = false;
                root.held = false;
                Drag.from = -1;
                return;
            }
            if ev.button != PointerEventButton.left {
                return;
            }
            if ev.kind == PointerEventKind.down {
                root.pressed-y = self.mouse-y;
                root.held = true;
            } else if ev.kind == PointerEventKind.up {
                if root.dragging {
                    root.dragging = false;
                    root.dropped();
                } else if root.held {
                    root.clicked(ev.modifiers.control, ev.modifiers.shift);
                }
                root.held = false;
            }
        }
        // The pressed row has the pointer, so the list would get no wheel.
        scroll-event(ev) => {
            if root.dragging {
                root.wheel(ev.delta-y);
                return accept;
            }
            reject
        }
        moved => {
            if !root.dragging && self.pressed && abs(self.mouse-y - root.pressed-y) > 6px {
                root.dragging = true;
                // Its release is a drop, never a click.
                root.held = false;
                Drag.grab = root.pressed-y;
                Drag.song = root.item.id;
                Drag.from = root.index;
            }
            if root.dragging {
                Drag.pointer = self.absolute-position.y + self.mouse-y;
            }
        }
    }

    Rectangle {
        opacity: root.dragged ? 0 : 1;
        border-radius: 6px;
        background: root.ghost ? Theme.menu : root.item.selected ? Theme.highlight : root.hot ? Theme.hover : transparent;
        drop-shadow-blur: root.ghost ? 16px : 0;
        drop-shadow-color: #00000080;
        animate background { duration: Theme.fast; }

        Art {
            x: 8px;
            width: 44px;
            height: 44px;
            source: root.item.art;
        }

        if root.item.current: Rectangle {
            x: 8px;
            width: 44px;
            height: 44px;
            border-radius: 4px;
            background: #00000090;
            Equalizer {
                active: Api.is-playing;
                color: Theme.on-colour;
            }
        }
        VerticalLayout {
            x: 64px;
            width: parent.width - 64px - 56px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.title;
                overflow: elide;
                font-size: 14px;
                font-weight: 500;
                color: root.item.current ? Theme.accent : Theme.text;
            }

            HorizontalLayout {
                spacing: 4px;
                if root.item.recommended: Icon {
                    y: (parent.height - self.height) / 2;
                    path: Icons.sparkle;
                    size: 12px;
                    color: Theme.text-secondary;
                }

                Text {
                    text: root.item.artists;
                    overflow: elide;
                    font-size: 13px;
                    color: Theme.text-secondary;
                }
            }
        }

        remove-button := IconButton {
            x: parent.width - self.width - 8px;
            icon: Icons.close;
            enabled: root.hot && !root.item.current;
            opacity: self.enabled ? 1 : 0;
            clicked => { root.remove(); }
        }

        if !root.hot || root.item.current: Text {
            x: parent.width - 52px;
            width: 40px;
            height: 100%;
            text: root.item.duration;
            color: Theme.text-secondary;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
