import { Theme } from "../theme.slint";
import { Api } from "../types.slint";
import { Pill } from "../widgets/buttons.slint";

/// A word or syllable as sung, its text keeping any space after it.
export struct LyricWord {
    text: string,
    start: float,
    end: float,
}

/// A line, with its words when sung word by word.
export struct LyricLine {
    text: string,
    words: [LyricWord],
    translation: string,
    romanised: string,
}

/// Which extras the lyrics have, and which are shown.
export global LyricsExtras {
    in property <bool> has-translation;
    in property <bool> has-romanisation;
    in property <bool> translate;
    in property <bool> romanise;
    callback set-translate(on: bool);
    callback set-romanise(on: bool);
}

/// Outside the Flickable, so they don't scroll away.
export component LyricsToggles inherits HorizontalLayout {
    if LyricsExtras.has-translation || LyricsExtras.has-romanisation: HorizontalLayout {
        padding-left: 24px;
        padding-top: 12px;
        alignment: start;
        spacing: 6px;
        if LyricsExtras.has-romanisation: Pill {
            label: "Romanisation";
            active: LyricsExtras.romanise;
            clicked => { LyricsExtras.set-romanise(!LyricsExtras.romanise); }
        }
        if LyricsExtras.has-translation: Pill {
            label: "Translation";
            active: LyricsExtras.translate;
            clicked => { LyricsExtras.set-translate(!LyricsExtras.translate); }
        }
    }
}

component Extra inherits Text {
    wrap: word-wrap;
    font-weight: 600;
    color: Theme.text-secondary;
    animate opacity { duration: Theme.normal; }
}

/// The song's time for the line sung word by word: `at` seconds when set,
/// moving on at `rate` until `until`, its last word's end.
export global LyricsClock {
    in property <float> at;
    in property <float> rate;
    in property <float> until;
}

/// The lyrics, line by line. Synced lyrics light up the line being sung,
/// glide it to the middle, and seek to a line when it is clicked; lyrics
/// timed by the word fill in as sung.
export component Lyrics inherits Flickable {
    in property <[LyricLine]> lines;
    in property <bool> synced;
    in property <int> current: -1;
    in property <string> source;
    in property <length> line-size: 22px;
    /// The lines not being sung.
    in property <float> rest-opacity: 0.5;
    /// Whether the lyrics are on screen, as a closed panel keeps them.
    in property <bool> shown: true;
    callback line-clicked(index: int);

    // An ease-out glide, written on whole pixels as the lists scroll.
    property <length> glide-from;
    property <length> glide-to;
    property <duration> glide-start;
    property <bool> gliding;
    property <float> glide-t: root.gliding ? min(1, (animation-tick() - root.glide-start) / 500ms) : 1;

    changed glide-t => {
        if root.gliding {
            root.content-y = round((root.glide-from + (root.glide-to - root.glide-from) * (1 - pow(1 - root.glide-t, 3))) / 1phx) * 1phx;
            root.gliding = root.glide-t < 1;
        }
    }

    // The words move on only while filling, and then about 60 times a second
    // from a timer, as a binding on the frame clock would redraw the whole
    // window at the screen's own rate (144 Hz or more on some).
    property <float> clock-at: LyricsClock.at;
    property <float> clock-rate: LyricsClock.rate;
    // Only a word-timed line on screen reads the time, and the clock is left
    // as it was once the song moves to lyrics without word timing.
    property <bool> filling: root.shown && root.current >= 0 && root.lines[root.current].words.length > 0
        && root.clock-rate > 0 && root.clock-at < LyricsClock.until && !Api.minimised;
    property <duration> clock-set;
    property <duration> clock-now;
    // `changed` misses the values the panel opens with. Both move together,
    // so a new clock never shows time from the old one.
    init => {
        root.clock-set = animation-tick();
        root.clock-now = root.clock-set;
    }
    changed clock-at => {
        root.clock-set = animation-tick();
        root.clock-now = root.clock-set;
    }
    changed clock-rate => {
        root.clock-set = animation-tick();
        root.clock-now = root.clock-set;
    }
    // winit waits on a high-resolution timer, so this fires on time; each
    // period runs from when the last fired, so a little under 60 Hz's frame
    // keeps a 60 Hz screen from ever showing one twice.
    Timer {
        interval: 15ms;
        running: root.filling;
        triggered => {
            root.clock-now = animation-tick();
        }
    }
    property <float> time: root.filling
        ? min(LyricsClock.until, root.clock-at + (root.clock-now - root.clock-set) / 1s * root.clock-rate)
        : root.clock-at;

    property <length> line-y;
    property <length> line-height;

    /// The scroll offset that puts the current line in the middle.
    pure function centred() -> length {
        clamp(root.height / 2 - root.line-y - root.line-height / 2, min(0px, root.height - root.content-height), 0px)
    }

    function centre-on(y: length, height: length) {
        root.line-y = y;
        root.line-height = height;
        root.content-y = root.centred();
    }

    /// Keeps the current line centred as rows resize; mid-glide, retargets it.
    function follow(y: length, height: length) {
        if root.gliding {
            root.line-y = y;
            root.line-height = height;
            root.glide-to = root.centred();
        } else {
            root.centre-on(y, height);
        }
    }

    // A line made current as the rows are created sees only the rows before
    // it, so it is centred again once the column has its full height.
    changed content-height => {
        if root.current >= 0 && !root.gliding {
            root.content-y = root.centred();
        }
    }

    // Another song's lyrics can replace these in place; a current line's row
    // centres itself as it is made, otherwise they start at the top.
    changed lines => {
        root.gliding = false;
        if root.current < 0 {
            root.content-y = 0;
        }
    }

    content-height: column.preferred-height;

    column := VerticalLayout {
        width: root.width;
        padding: 24px;
        padding-top: 16px;
        spacing: 12px;
        // Dimmed in its texts rather than as a whole, as `opacity` on an item
        // with several children draws it through a layer of its own.
        for line[i] in root.lines: TouchArea {
            property <bool> is-current: i == root.current;
            property <float> alpha: !root.synced || self.is-current ? 1 : self.has-hover ? 0.8 : root.rest-opacity;
            enabled: root.synced;
            mouse-cursor: self.enabled ? pointer : default;
            clicked => { root.line-clicked(i); }

            changed is-current => {
                if self.is-current {
                    root.line-y = self.y;
                    root.line-height = self.height;
                    root.glide-from = root.content-y;
                    root.glide-to = root.centred();
                    root.glide-start = animation-tick();
                    root.gliding = true;
                }
            }
            // Opened mid-song, start at the line being sung, and stay on it
            // as the word-wrapped rows above settle their heights.
            init => {
                if self.is-current {
                    root.centre-on(self.y, self.height);
                }
            }
            changed y => {
                if self.is-current {
                    root.follow(self.y, self.height);
                }
            }
            changed height => {
                if self.is-current {
                    root.follow(self.y, self.height);
                }
            }

            VerticalLayout {
                if line.words.length == 0: Text {
                    text: line.text;
                    wrap: word-wrap;
                    font-size: root.line-size;
                    font-weight: 700;
                    font-family: Theme.display-font;
                    color: Theme.text;
                    opacity: alpha;
                    animate opacity { duration: Theme.normal; }
                }
                // Word-timed lines always wrap as words, so a line keeps its
                // height as it starts and ends.
                if line.words.length > 0: FlexboxLayout {
                    for word in line.words: Text {
                        // How much has been sung, 0 to 1.
                        property <float> sung: is-current ? clamp((root.time - word.start) / max(word.end - word.start, 0.001), 0, 1) : 0;
                        property <color> dim: Theme.text.with-alpha(is-current ? root.rest-opacity : alpha);
                        text: word.text;
                        font-size: root.line-size;
                        font-weight: 700;
                        font-family: Theme.display-font;
                        // A hard stop where the singing has got to.
                        color: self.sung <= 0 ? self.dim
                            : self.sung >= 1 ? Theme.text
                            : @linear-gradient(90deg, Theme.text 0%, Theme.text self.sung * 100%, self.dim self.sung * 100%, self.dim 100%);
                    }
                }
                if LyricsExtras.romanise && line.romanised != "": Extra {
                    text: line.romanised;
                    font-size: root.line-size * 0.7;
                    opacity: alpha;
                }
                if LyricsExtras.translate && line.translation != "": Extra {
                    text: line.translation;
                    font-size: root.line-size * 0.7;
                    opacity: alpha;
                }
            }
        }
        if root.source != "": Text {
            text: root.source;
            font-size: 12px;
            color: Theme.text-secondary;
        }
    }
}
