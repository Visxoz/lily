export struct TrackItem {
    id: string,
    title: string,
    artists: string,
    album: string,
    duration: string,
    art: image,
    number: string,
    has-artist: bool,
    has-album: bool,
    downloaded: bool,
    /// A file on this PC, which YouTube's actions don't apply to.
    local: bool,
}

export struct CardItem {
    kind: string,
    id: string,
    title: string,
    subtitle: string,
    art: image,
    round: bool,
    tint: color,
    /// Pinned to the top of the sidebar.
    pinned: bool,
}

export enum RowKind { greeting, header, title, columns, track, carousel, grid, chips, top, songs }

/// One row of the virtualised page list.
export struct RowItem {
    kind: RowKind,
    // header, title and greeting
    label: string,
    title: string,
    subtitle: string,
    meta: string,
    art: image,
    /// The artwork blurred, behind a header's square copy.
    backdrop: image,
    round: bool,
    banner: bool,
    can-play: bool,
    can-shuffle: bool,
    can-radio: bool,
    can-download: bool,
    /// The page has a YouTube Music link to copy.
    can-share: bool,
    /// Every one of the page's tracks is downloaded.
    downloaded: bool,
    /// The album or playlist can be saved to the library, and whether it is.
    can-save: bool,
    saved: bool,
    /// The artist can be subscribed to, and whether they are.
    can-subscribe: bool,
    subscribed: bool,
    // track rows and their column header
    track: TrackItem,
    numbered: bool,
    show-album: bool,
    // card rows
    cards: [CardItem],
    /// A song shelf's songs, in columns that scroll sideways.
    tracks: [TrackItem],
    // where the row's items live in the page, for callbacks
    section: int,
    index: int,
}

export struct QueueItem {
    id: string,
    title: string,
    artists: string,
    duration: string,
    art: image,
    current: bool,
    /// Mixed in by Smart Shuffle.
    recommended: bool,
    /// Picked with Ctrl- or Shift-click.
    selected: bool,
    local: bool,
    downloaded: bool,
}

export struct AccentChoice {
    name: string,
    colour: color,
    /// Taken from the playing song's artwork rather than `colour`.
    artwork: bool,
}

/// One of the account's playlists, offered for saving a song to.
export struct PlaylistChoice {
    title: string,
    /// Already holds the song.
    contains: bool,
}

/// Calls from anywhere in the UI into Rust, and state many components read.
export global Api {
    callback navigate(kind: string, id: string);
    callback play-track(section: int, index: int);
    /// A page or queue row without its artwork has come on screen.
    callback row-art(row: int);
    callback queue-art(row: int);
    callback track-action(action: string, section: int, index: int);
    callback play-card(kind: string, id: string);
    callback card-radio(kind: string, id: string);
    callback card-download(kind: string, id: string);
    /// A menu action on a song, album, playlist or artist, by its card kind.
    callback card-action(action: string, kind: string, id: string);
    /// "Block" or "Unblock" and the artist that a song's or artist's
    /// "block" action acts on, or empty for none; "header" is the page's.
    callback block-label(kind: string, id: string) -> string;
    /// The same for a song row's "block" `track-action`.
    callback track-block-label(section: int, index: int) -> string;
    /// Downloads a song in the queue, or removes its download.
    callback download(id: string, remove: bool);
    callback header-action(action: string);
    /// Shows the search through the filter at `index` in `search-filters`.
    callback filter-search(index: int);
    /// `SearchKind::filter_labels`.
    in property <[string]> search-filters;
    /// The search page's filter, or -1 off it.
    in property <int> search-filter: -1;
    /// The page's next step waits for a row near its end, so rows with art
    /// ask too.
    in property <bool> more-paused;
    /// Likes (1) or dislikes (2) a song, or takes that back if it had it;
    /// 0 removes either.
    callback rate(id: string, rating: int);
    callback save-to-playlist(id: string);
    /// Moves song `from` of the page's own playlist, the song `id`, to `to`.
    callback move-track(from: int, to: int, id: string);
    in property <bool> signed-in;
    /// How the account rated the playing song: 0 none, 1 like, 2 dislike.
    in property <int> playing-rating;
    in property <string> playing-id;
    in property <bool> playing-local;
    in property <bool> playing-downloaded;
    in property <bool> is-playing;
    /// Advanced a few times a second while playing; drives the equalisers
    /// without repainting every frame.
    in property <int> eq-phase;
    /// Minimised or in the tray: stills the placeholders' pulse.
    in property <bool> minimised;
    /// The page is one of the account's own playlists, loaded whole, which
    /// its menus and dragging edit; how many songs it has, and who can see
    /// it: 0 public, 1 unlisted, 2 private.
    in property <bool> own-playlist;
    in property <int> own-songs;
    in property <int> own-privacy;

    /// The rating known for `id`: only the playing song's is.
    public pure function rating-of(id: string) -> int {
        id == root.playing-id ? root.playing-rating : 0
    }
}
