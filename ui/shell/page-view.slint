import { Theme } from "../theme.slint";
import { Api, RowItem, RowKind } from "../types.slint";
import { PageRow } from "../page/page-row.slint";
import { PageDrag } from "../page/track-row.slint";
import { PillButton, PillGroup, PlayButton } from "../widgets/buttons.slint";
import { ListView } from "../widgets/list.slint";
import { PagePlaceholder } from "../widgets/skeleton.slint";

/// A round glow of `colour`, fading out from its centre.
component Glow inherits Rectangle {
    in property <length> size;
    in property <color> colour;
    in property <float> strength;
    width: root.size;
    height: root.size;
    background: @radial-gradient(circle, Theme.tint(root.colour).with-alpha(root.strength) 0%, Theme.tint(root.colour).with-alpha(0) 70%);
}

export component PageView inherits Rectangle {
    in property <[RowItem]> rows;
    in property <bool> page-loading;
    /// What the loading page looks like: see `PagePlaceholder`.
    in property <string> page-shape;
    in property <string> page-error;
    in property <string> page-title;
    in property <bool> page-can-play;
    /// The page's tint, or transparent for the theme's own.
    in property <color> accent;
    property <color> tint: root.accent.alpha == 0 ? Theme.home-tint : root.accent;
    in property <string> nav-current;
    /// Home's rows open with the greeting; `nav-current` changes before the rows
    /// do. An empty model's row 0 is a default row, also of the greeting's kind.
    property <bool> home: root.rows.length > 0 && root.rows[0].kind == RowKind.greeting;
    in-out property <length> page-scroll;
    in-out property <bool> sign-in-open;

    callback go(nav: string);

    property <bool> own-playlist: Api.own-playlist;
    // A drag cut short by leaving the page isn't to come back with it.
    changed own-playlist => { PageDrag.from = -1; }
    property <bool> dragging: Api.own-playlist && PageDrag.from >= 0;
    // A song dragged under the sticky title, or near the bottom, scrolls the page;
    // not once off it, as a release there would miss the takeover below.
    property <bool> over-page: PageDrag.pointer-x >= root.absolute-position.x
        && PageDrag.pointer-x < root.absolute-position.x + root.width
        && PageDrag.pointer >= root.absolute-position.y
        && PageDrag.pointer < root.absolute-position.y + root.height;
    property <int> drag-edge: !root.dragging || !root.over-page ? 0
        : PageDrag.pointer < root.absolute-position.y + 64px ? -1
        : PageDrag.pointer > root.absolute-position.y + root.height - 24px ? 1 : 0;

    horizontal-stretch: 1;
    border-radius: Theme.panel-radius;
    background: Theme.panel;
    clip: true;

    Rectangle {
        y: root.page-scroll;
        height: root.home ? 560px : 420px;
        // Home's base is fainter, so its glows stand out of it.
        background: @linear-gradient(180deg, Theme.tint(root.home ? root.tint.mix(Theme.panel, 0.35) : root.tint) 0%, Theme.panel 100%);
        animate background { duration: 500ms; }
        // Hidden under a header's blurred artwork, as it runs further down.
        opacity: root.rows[0].backdrop.width > 0 ? 0 : 1;
        animate opacity { duration: 400ms; }

        // Two soft glows, the accent's and a violet's, after the icon's gradient.
        if root.home: Glow {
            x: root.width * 0.18 - self.width / 2;
            y: -self.height / 2 + 40px;
            size: 960px;
            colour: Theme.accent;
            strength: 0.26;
        }
        if root.home: Glow {
            x: root.width * 0.82 - self.width / 2;
            y: -self.height / 2 + 100px;
            size: 820px;
            colour: Theme.home-glow;
            strength: 0.22;
        }
    }

    // A search's filters, above its results rather than among them, so they
    // stay while one loads or has none; wrapping, so a narrow page has them all.
    filters := PillGroup {
        x: Theme.page-padding;
        y: 16px;
        width: root.width - 2 * Theme.page-padding;
        height: self.preferred-height;
        visible: Api.search-filter >= 0;
        flex-wrap: wrap;
        labels: Api.search-filters;
        current: Api.search-filter;
        picked(i) => { Api.filter-search(i); }
    }
    property <length> filters-height: filters.visible ? filters.height + 24px : 0;
    // The page left keeps its place while it fades, as the filters come or go.
    property <length> rows-top;
    changed filters-height => {
        if !root.page-loading {
            root.rows-top = root.filters-height;
        }
    }

    // Rows added just after a load fade in, as Home's later shelves.
    property <bool> settling;
    // Cleared on each load, so the next restarts the timer.
    changed page-loading => {
        root.settling = !root.page-loading;
        if !root.page-loading {
            root.rows-top = root.filters-height;
        }
    }
    Timer {
        interval: 2s;
        running: root.settling;
        triggered => { root.settling = false; }
    }

    // Beneath the page, and kept while the page fades in over it.
    if (root.page-loading || content.opacity < 1) && root.page-error == "": PagePlaceholder {
        y: root.filters-height;
        height: root.height - root.filters-height;
        shape: root.page-shape;
        loading: root.page-loading;
    }

    Rectangle {
        y: root.rows-top;
        height: root.height - root.rows-top;

        content := Rectangle {
            property <bool> hidden: root.page-loading || root.page-error != "";
            opacity: self.hidden ? 0 : 1;
            // Rises as it fades in; the page left goes quicker.
            y: self.hidden ? 16px : 0;
            visible: self.opacity > 0;
            animate opacity, y {
                duration: self.hidden ? 160ms : 450ms;
                easing: ease-out;
            }
            list := ListView {
                width: 100%;
                height: 100%;
                content-y <=> root.page-scroll;
                for row[i] in root.rows: PageRow {
                    data: row;
                    index: i;
                    // A row's `y` is its place in the content, so the scroll comes off here.
                    view-top: -list.content-y - self.y;
                    view-height: list.visible-height;
                    home: root.home;
                    // Not during the page's own fade, or the two compound.
                    fade-in: root.settling && content.opacity >= 1;
                    content-width: list.visible-width;
                }
            }
        }
    }

    // Sticky title once the header scrolls away.
    Rectangle {
        y: 0;
        height: 64px;
        background: Theme.tint(root.tint.darker(0.35));
        opacity: root.page-title != "" && -root.page-scroll > 280px && !root.page-loading ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.normal; }
        TouchArea { }

        HorizontalLayout {
            padding-left: Theme.page-padding;
            spacing: 12px;
            if root.page-can-play: PlayButton {
                y: (parent.height - self.height) / 2;
                size: 44px;
                clicked => { Api.header-action("play"); }
            }
            Text {
                text: root.page-title;
                vertical-alignment: center;
                font-size: 22px;
                font-weight: 800;
                font-family: Theme.display-font;
                color: Theme.text;
                overflow: elide;
            }
        }
    }

    Timer {
        interval: 16ms;
        running: root.drag-edge != 0;
        triggered => {
            list.content-y = clamp(list.content-y - root.drag-edge * 8px,
                min(0px, list.visible-height - list.content-height), 0px);
        }
    }

    // Takes over a drag once the list has dropped the dragged song's row,
    // scrolled out of view, as the pointer's events then come here.
    if root.dragging: TouchArea {
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.move {
                PageDrag.pointer-x = self.absolute-position.x + self.mouse-x;
                PageDrag.pointer = self.absolute-position.y + self.mouse-y;
            } else if ev.kind == PointerEventKind.up {
                PageDrag.drop();
            } else if ev.kind == PointerEventKind.down {
                // Let go of outside the page: a press is a new start.
                PageDrag.from = -1;
            }
        }
        changed has-hover => {
            if !self.has-hover {
                PageDrag.from = -1;
            }
        }
    }

    if !root.page-loading && root.page-error != "": VerticalLayout {
        y: root.filters-height;
        height: root.height - root.filters-height;
        alignment: center;
        spacing: 20px;
        padding: 48px;
        Text {
            text: root.page-error;
            horizontal-alignment: center;
            font-size: 18px;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }

        // Downloads has nothing to try again.
        if root.nav-current != "downloads": HorizontalLayout {
            alignment: center;
            PillButton {
                text: root.nav-current == "local" ? "Add folder"
                    : root.nav-current == "library" && !Api.signed-in ? "Sign in" : "Try again";
                primary: true;
                clicked => {
                    if root.nav-current == "local" {
                        root.go("add-folder");
                    } else if root.nav-current == "library" && !Api.signed-in {
                        root.sign-in-open = true;
                    } else {
                        root.go("reload");
                    }
                }
            }
        }
    }
}
