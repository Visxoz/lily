import { Theme } from "../theme.slint";
import { LyricLine, Lyrics, LyricsToggles } from "../panel/lyrics.slint";
import { Art } from "../widgets/art.slint";
import { LyricsPlaceholder } from "../widgets/skeleton.slint";

export component FullPlayer inherits Rectangle {
    in property <image> art;
    in property <image> backdrop;
    /// The animated artwork's frame, filling the player once it has one.
    in property <image> motion;
    in property <string> title;
    in property <string> artists;
    in property <string> next;
    in property <[LyricLine]> lyrics;
    in property <bool> lyrics-synced;
    in property <int> lyrics-current;
    in property <string> lyrics-source;
    in property <bool> lyrics-loading;
    in property <length> drawer-width;
    callback lyric-clicked(index: int);
    property <bool> moving: root.motion.width > 0;
    property <length> margin: 64px;
    property <length> art-size: clamp(min((root.width - root.drawer-width - 3 * root.margin) / 2, root.height - Theme.player-bar - 2 * root.margin - 140px), 0px, 560px);
    background: Theme.panel;

    Image {
        width: 100%;
        height: 100%;
        source: root.backdrop;
        image-fit: fill;
    }

    Image {
        width: 100%;
        height: 100%;
        source: root.motion;
        image-fit: cover;
        opacity: root.moving ? 1 : 0;
        animate opacity { duration: 500ms; }
    }

    // Pales the colours in the light look, as `Theme.tint` does, and dims a
    // clip under the lyrics in the others.
    Rectangle {
        background: Theme.panel.with-alpha(Theme.light ? 0.7 : 0.55);
        opacity: Theme.light || root.moving ? 1 : 0;
        animate opacity { duration: 500ms; }
    }

    // Deeper behind the lyrics, so a busy clip stays readable there and
    // vivid around the art.
    Rectangle {
        x: (root.width - root.drawer-width) / 2 - root.margin;
        width: root.width - self.x;
        background: @linear-gradient(90deg, Theme.panel.with-alpha(0) 0%, Theme.panel.with-alpha(0.6) 30%, Theme.panel.with-alpha(0.6) 100%);
        opacity: root.moving ? 1 : 0;
        animate opacity { duration: 500ms; }
    }

    // Two halves, each centring its part, so space shares out at any width.
    HorizontalLayout {
        width: root.width - root.drawer-width;
        height: root.height - Theme.player-bar;
        padding: root.margin;
        spacing: root.margin;
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                x: (parent.width - self.width) / 2;
                width: root.art-size;
                height: 100%;
                alignment: center;
                spacing: 6px;
                Art {
                    height: root.art-size;
                    radius: 8px;
                    source: root.art;
                    drop-shadow-blur: 32px;
                    drop-shadow-color: #00000080;
                }

                Rectangle {
                    height: 18px;
                }

                Text {
                    text: root.title;
                    overflow: elide;
                    font-family: Theme.display-font;
                    font-size: 28px;
                    font-weight: 700;
                    color: Theme.text;
                }

                Text {
                    text: root.artists;
                    overflow: elide;
                    font-size: 16px;
                    color: Theme.text-secondary;
                }

                if root.next != "": Text {
                    text: root.next;
                    overflow: elide;
                    font-size: 13px;
                    color: Theme.text-secondary;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            if root.lyrics-loading: LyricsPlaceholder {
                x: (parent.width - self.width) / 2;
                width: min(parent.width, 800px);
                line-size: 34px;
            }
            // Lines much wider than this are hard to follow.
            if !root.lyrics-loading: VerticalLayout {
                x: (parent.width - self.width) / 2;
                width: min(parent.width, 800px);
                LyricsToggles { }
                Lyrics {
                    line-size: 34px;
                    rest-opacity: root.moving ? 0.65 : 0.5;
                    lines: root.lyrics;
                    synced: root.lyrics-synced;
                    current: root.lyrics-current;
                    source: root.lyrics-source;
                    line-clicked(i) => { root.lyric-clicked(i); }
                }
            }
        }
    }
}
