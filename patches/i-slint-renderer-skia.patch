+    /// Frees the GPU resources in Skia's cache that nothing has used for a while, as Skia
+    /// otherwise keeps them until its budget fills. Resources still referenced, or in use by
+    /// submitted work, aren't purgeable, so only idle ones go.
+    fn clean_up_cache(&self, gr_context: &mut skia_safe::gpu::DirectContext) {
+        if self.last_cleanup.get().elapsed() < CACHE_CLEANUP_EVERY {
+            return;
+        }
+        self.last_cleanup.set(Instant::now());
+        gr_context.perform_deferred_cleanup(
+            CACHE_UNUSED_FOR,
+            skia_safe::gpu::PurgeResourceOptions::AllResources,
+        );
+        if cfg!(debug_assertions) {
+            let usage = gr_context.resource_cache_usage();
+            i_slint_core::debug_log!(
+                "Skia resource cache: {} bytes in {} resources, limit {} bytes",
+                usage.resource_bytes,
+                usage.resource_count,
+                gr_context.resource_cache_limit()
+            );
+        }
+    }
 }
 
